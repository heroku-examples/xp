#!/bin/bash

# web - Simple HTTP server that responds with colored HTML pages
# Usage: PORT=8080 COLOR=red DELAY=2 ./web

PORT=${PORT:-8080}
COLOR=${COLOR:-green}
DELAY=${DELAY:-1}

echo "Starting HTTP server on port $PORT" >&2
echo "Color: $COLOR, Delay: ${DELAY}s" >&2

# Use Perl to create the HTTP server with forking for concurrency
perl -MIO::Socket::INET -e '
$port = $ENV{PORT} || 8080;
$color = $ENV{COLOR} || "blue";
$delay = $ENV{DELAY} || 0;

$server = IO::Socket::INET->new(
    LocalPort => $port,
    Type => SOCK_STREAM,
    Reuse => 1,
    Listen => 10
) or die "Cannot create socket: $!\n";

print STDERR "Server listening on port $port\n";

# Reap zombie child processes
$SIG{CHLD} = "IGNORE";

while (1) {
    next unless $client = $server->accept();

    # Fork to handle request concurrently
    $pid = fork();

    if (!defined $pid) {
        warn "Cannot fork: $!\n";
        close $client;
        next;
    }

    if ($pid == 0) {
        # Child process
        $server->close();

        # Read HTTP request
        while (<$client>) {
            last if /^\r?\n$/;
        }

        # Apply delay
        sleep($delay) if $delay > 0;

        # Send HTTP response
        print $client "HTTP/1.1 200 OK\r\n";
        print $client "Content-Type: text/html\r\n";
        print $client "Connection: close\r\n\r\n";
        print $client <<"HTML";
<!DOCTYPE html>
<html>
<head>
<title>$delay $color</title>
<style>
body {
    background-color: $color;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    padding: 10% 0;
    font-family: sans-serif;
    box-sizing: border-box;
    overflow: hidden;
}
h1 {
    font-size: 80vh;
    line-height: 80vh;
    margin: 0;
    text-transform: uppercase;
    
    /* Reduced Contrast Reflective Gradient */
    background: linear-gradient(
        to bottom, 
        #ffffff 0%, 
        #f2f2f2 40%, 
        #dcdcdc 48%, 
        #e6e6e6 52%, 
        #ffffff 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0.9;
    mix-blend-mode: difference;
    filter: drop-shadow(0px 15px 5px rgba(0, 0, 0, 0.4))
            drop-shadow(0px 30px 15px rgba(0, 0, 0, 0.3));
}
</style>
</head>
<body>
<h1>$delay</h1>
</body>
</html>
HTML
        $client->close();
        exit 0;
    }

    # Parent process
    $client->close();
}
'
