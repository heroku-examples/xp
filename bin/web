#!/bin/bash

# web - Simple HTTP server that responds with colored HTML pages
# Usage: PORT=8080 COLOR=red DELAY=2 ./web

PORT=${PORT:-8080}
COLOR=${COLOR:-white}
DELAY=${DELAY:-0}

echo "Starting HTTP server on port $PORT" >&2
echo "Color: $COLOR, Delay: ${DELAY}s" >&2

# Use Perl to create the HTTP server
perl -MIO::Socket::INET -e '
$port = $ENV{PORT} || 8080;
$color = $ENV{COLOR} || "white";
$delay = $ENV{DELAY} || 0;

$server = IO::Socket::INET->new(
    LocalPort => $port,
    Type => SOCK_STREAM,
    Reuse => 1,
    Listen => 10
) or die "Cannot create socket: $!\n";

print STDERR "Server listening on port $port\n";

while ($client = $server->accept()) {
    # Read HTTP request
    while (<$client>) {
        last if /^\r?\n$/;
    }

    # Apply delay
    sleep($delay) if $delay > 0;

    # Send HTTP response
    print $client "HTTP/1.1 200 OK\r\n";
    print $client "Content-Type: text/html\r\n";
    print $client "Connection: close\r\n\r\n";
    print $client <<"HTML";
<!DOCTYPE html>
<html>
<head>
<title>$COLOR $DELAY</title>
<style>
body {
    background-color: $COLOR;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    padding: 10% 0;
    font-family: sans-serif;
    box-sizing: border-box;
}
h1 {
    color: white;
    font-size: 80vh;
    line-height: 80vh;
    margin: 0;
    text-transform: uppercase;
}
</style>
</head>
<body>
<h1>$DELAY</h1>
</body>
</html>
HTML
    close $client;
}
'
