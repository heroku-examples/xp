#!/bin/bash

# web - Simple HTTP server that responds with colored HTML pages
# Usage: PORT=8080 COLOR=red DELAY=2 ./web

PORT=${PORT:-8080}
COLOR=${COLOR:-white}
DELAY=${DELAY:-0}

echo "Starting HTTP server on port $PORT" >&2
echo "Color: $COLOR, Delay: ${DELAY}s" >&2

# Use Perl to create the HTTP server with forking for concurrency
perl -MIO::Socket::INET -e '
$port = $ENV{PORT} || 8080;
$color = $ENV{COLOR} || "white";
$delay = $ENV{DELAY} || 0;

$server = IO::Socket::INET->new(
    LocalPort => $port,
    Type => SOCK_STREAM,
    Reuse => 1,
    Listen => 10
) or die "Cannot create socket: $!\n";

print STDERR "Server listening on port $port\n";

# Reap zombie child processes
$SIG{CHLD} = "IGNORE";

while (1) {
    next unless $client = $server->accept();

    # Fork to handle request concurrently
    $pid = fork();

    if (!defined $pid) {
        warn "Cannot fork: $!\n";
        close $client;
        next;
    }

    if ($pid == 0) {
        # Child process
        $server->close();

        # Read HTTP request
        while (<$client>) {
            last if /^\r?\n$/;
        }

        # Apply delay
        sleep($delay) if $delay > 0;

        # Send HTTP response
        print $client "HTTP/1.1 200 OK\r\n";
        print $client "Content-Type: text/html\r\n";
        print $client "Connection: close\r\n\r\n";
        print $client <<"HTML";
<!DOCTYPE html>
<html>
<head>
    <title>Web Server</title>
    <style>
        body {
            background-color: $color;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            margin: 0;
            font-family: Arial, sans-serif;
        }
        .delay {
            font-size: 200px;
            font-weight: bold;
            color: rgba(0, 0, 0, 0.8);
        }
    </style>
</head>
<body>
    <div class="delay">$delay</div>
</body>
</html>
HTML
        $client->close();
        exit 0;
    }

    # Parent process
    $client->close();
}
'
