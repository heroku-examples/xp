#!/bin/bash

# Echo server - returns request headers and body as HTML with configurable background color
# Listens on $PORT (default 8080)
# Works on both Ubuntu (Linux) and macOS

PORT="${PORT:-8080}"
COLOR="${COLOR:-blue}"
DELAY="${DELAY:-0}"

# Create a temporary FIFO for the response
FIFO=$(mktemp -u)
mkfifo "$FIFO"
trap "rm -f $FIFO" EXIT

# Request handler function
handle_request() {
    request=""
    content_length=0
    status_code=200
    
    # Read headers
    while IFS= read -r line; do
        line="${line%%$'\r'}"
        
        # Parse request line for path (e.g., GET /123 HTTP/1.1)
        if [[ "$line" =~ ^[A-Z]+\ /([0-9]+)\ HTTP ]]; then
            status_code="${BASH_REMATCH[1]}"
        fi
        
        if [[ "$line" =~ ^[Cc]ontent-[Ll]ength:\ *([0-9]+) ]]; then
            content_length="${BASH_REMATCH[1]}"
        fi
        
        request+="$line"$'\n'
        [[ -z "$line" ]] && break
    done
    
    # Read body if present
    if [[ "$content_length" -gt 0 ]]; then
        body=$(head -c "$content_length")
        request+="$body"
    fi
    
    # Sleep for configured delay (only if DELAY is a positive number)
    if [[ "$DELAY" =~ ^[0-9]+$ ]] && [[ "$DELAY" -gt 0 ]]; then
        sleep "$DELAY"
    fi

    # Build HTML response with colored background
    html_response="<!DOCTYPE html>
<html>
<head>
    <meta charset=\"utf-8\">
    <style>
        body { background-color: $COLOR; margin: 20px; color: white; }
        pre { white-space: pre-wrap; word-wrap: break-word; }
    </style>
</head>
<body>
<pre>$request</pre>
</body>
</html>"

    response_length=${#html_response}

    printf "HTTP/1.1 %d OK\r\n" "$status_code"
    printf "Content-Type: text/html; charset=utf-8\r\n"
    printf "Content-Length: %d\r\n" "$response_length"
    printf "Connection: close\r\n"
    printf "\r\n"
    printf "%s" "$html_response"
}

echo "Starting echo server on port $PORT with background color $COLOR and delay ${DELAY}s..."

# Main loop - use different netcat syntax for Linux vs macOS
while true; do
    if [[ "$(uname)" == "Darwin" ]]; then
        # macOS: nc -l <port>
        nc -l "$PORT" < "$FIFO" | handle_request > "$FIFO"
    else
        # Ubuntu/Linux: nc -l <port> (no -p flag on modern versions)
        nc -l "$PORT" < "$FIFO" | handle_request > "$FIFO"
    fi
done
