# syntax=docker/dockerfile:1
FROM --platform=linux/amd64 heroku/heroku:22

# Install curl for testing
RUN apt-get update && apt-get install -y curl && rm -rf /var/lib/apt/lists/*

# Copy scripts and set permissions in one layer
COPY bin/bashweb test/test-bashweb-delay.sh /app/
RUN chmod +x /app/bashweb /app/test-bashweb-delay.sh

WORKDIR /app

# Run the test
CMD ["/app/test-bashweb-delay.sh"]
