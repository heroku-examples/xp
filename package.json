{
  "name": "@heroku-cli/plugin-experiments",
  "version": "1.0.0",
  "description": "Heroku CLI plugin for managing experiment apps with traffic routing",
  "author": "Heroku",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/heroku/experiments.git"
  },
  "bugs": {
    "url": "https://github.com/heroku/experiments/issues"
  },
  "homepage": "https://github.com/heroku/experiments#readme",
  "keywords": [
    "heroku",
    "heroku-plugin",
    "experiments",
    "traffic-routing",
    "a-b-testing",
    "experimentation",
    "cli"
  ],
  "files": [
    "/lib",
    "/oclif.manifest.json",
    "/bin"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf lib oclif.manifest.json",
    "lint": "eslint . --ext .ts",
    "prepack": "yarn build && oclif manifest && oclif readme",
    "postpack": "rm -f oclif.manifest.json",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "oclif readme && git add README.md"
  },
  "dependencies": {
    "@heroku-cli/command": "^10.0.0",
    "@heroku-cli/schema": "^1.0.0",
    "@oclif/core": "^3.0.0",
    "@oclif/plugin-help": "^6.0.0",
    "@oclif/plugin-plugins": "^4.0.0",
    "cli-ux": "^6.0.9",
    "debug": "^4.4.3",
    "tslib": "^2.6.0"
  },
  "devDependencies": {
    "@oclif/test": "^3.0.0",
    "@types/chai": "^4.3.11",
    "@types/debug": "^4.1.13",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/sinon": "^17.0.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "chai": "^4.3.10",
    "eslint": "^8.55.0",
    "eslint-config-oclif": "^5.0.0",
    "eslint-config-oclif-typescript": "^3.0.0",
    "mocha": "^10.2.0",
    "oclif": "^4.0.0",
    "sinon": "^17.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "oclif": {
    "bin": "heroku",
    "dirname": "heroku",
    "commands": "./lib/commands",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-plugins"
    ],
    "topics": {
      "experiments": {
        "description": "Manage experiment apps with traffic routing"
      },
      "xp": {
        "description": "Manage experiment apps with traffic routing (alias for experiments)"
      }
    },
    "topicSeparator": ":",
    "hooks": {},
    "repositoryPrefix": "<%- repo %>/blob/main/<%- commandPath %>"
  }
}
